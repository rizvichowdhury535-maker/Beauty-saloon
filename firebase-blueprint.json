{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Client or studio admin profile and notification settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "location": { "type": "string", "maxLength": 160 },
        "skinType": { "type": "string", "maxLength": 64 },
        "preferredStyle": { "type": "string", "maxLength": 80 },
        "emailRemindersEnabled": { "type": "boolean" },
        "whatsappRemindersEnabled": { "type": "boolean" },
        "encryptedNotes": { "type": "string", "maxLength": 4096 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "emailRemindersEnabled", "whatsappRemindersEnabled", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Makeup session booking with deposit transaction and encrypted consultation notes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "clientEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "clientPhone": { "type": "string", "minLength": 5, "maxLength": 32 },
        "serviceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "lookId": { "type": "string", "maxLength": 64 },
        "lookTitle": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "timeSlot": { "type": "string", "minLength": 3, "maxLength": 32 },
        "totalAmount": { "type": "number" },
        "depositAmount": { "type": "number" },
        "depositStatus": { "type": "string", "enum": ["pending", "paid", "refunded"] },
        "paymentMethod": { "type": "string", "enum": ["bKash", "Nagad", "Card", "Bank"] },
        "transactionRef": { "type": "string", "minLength": 4, "maxLength": 64 },
        "status": { "type": "string", "enum": ["confirmed", "completed", "cancelled"] },
        "encryptedNotes": { "type": "string", "maxLength": 4096 },
        "reminderSent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "clientName", "clientEmail", "clientPhone", "serviceId", "serviceTitle", "date", "timeSlot", "totalAmount", "depositAmount", "depositStatus", "paymentMethod", "transactionRef", "status", "reminderSent", "createdAt", "updatedAt"]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "Public slot lock record without PII to compute live calendar availability.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "timeSlot": { "type": "string", "minLength": 3, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookingId", "date", "timeSlot", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "End-to-end encrypted direct messaging channel between a client and Farhana's studio.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "encryptionAlgo": { "type": "string", "enum": ["AES-256-GCM"] },
        "keyFingerprint": { "type": "string", "minLength": 8, "maxLength": 64 },
        "lastMessagePreview": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "clientName", "encryptionAlgo", "keyFingerprint", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual encrypted chat message within a conversation.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["client", "studio"] },
        "ciphertext": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "iv": { "type": "string", "minLength": 8, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "senderId", "senderName", "senderRole", "ciphertext", "iv", "createdAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Automated email/calendar reminder dispatch log for confirmed bookings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "channel": { "type": "string", "enum": ["email", "calendar", "whatsapp"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 180 },
        "scheduledFor": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["scheduled", "sent"] },
        "sentAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookingId", "recipientEmail", "channel", "subject", "scheduledFor", "status", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Verified client testimonial for makeup artistry sessions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "occasion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "quote": { "type": "string", "minLength": 10, "maxLength": 600 },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "clientName", "occasion", "quote", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private client profile and notification preferences isolated to owner or studio admin."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Makeup session bookings and deposit records isolated to booking owner or studio admin."
    },
    "/bookedSlots/{slotId}": {
      "schema": { "$ref": "#/entities/BookedSlot" },
      "description": "Public time slot locks without PII for real-time booking calendar availability."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct encrypted chat threads between a client and Signature Artistry by Farhana."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "End-to-end encrypted messages belonging to a conversation."
    },
    "/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "Automated email and session reminder records per booking."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Client testimonials publicly displayed adjacent to the lookbook and booking flow."
    }
  }
}
